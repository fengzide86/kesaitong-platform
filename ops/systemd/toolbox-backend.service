[Unit]
Description=Kesaitong Platform control-plane backend (legacy unit name)
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=simple
User=toolbox
Group=toolbox
WorkingDirectory=/opt/kesaitong-platform/backend
EnvironmentFile=/opt/kesaitong-platform/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TOOLBOX_RUNTIME_DIR=/opt/kesaitong-platform/backend/runtime
Environment=UPDATE_RELEASE_DIR=/var/lib/kesaitong-platform/updates
Environment=EXPENSE_ATTACHMENT_DIR=/var/lib/kesaitong-platform/expense-attachments
EnvironmentFile=-/var/lib/kesaitong-platform/release.env
ExecStart=/opt/kesaitong-platform/current-venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3s
TimeoutStartSec=45s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadWritePaths=-/opt/kesaitong-platform/backend/updates
ReadWritePaths=-/opt/kesaitong-platform/backend/.updates-staging
ReadWritePaths=-/var/lib/kesaitong-platform/updates
ReadWritePaths=-/var/lib/kesaitong-platform/.updates-staging
ReadWritePaths=-/var/lib/kesaitong-platform/expense-attachments
ReadWritePaths=-/opt/kesaitong-platform/backend/chroma_db
ReadWritePaths=-/opt/kesaitong-platform/backend/uploads
ReadWritePaths=-/opt/kesaitong-platform/backend/runtime
ReadWritePaths=-/opt/kesaitong-platform/backend/logs

[Install]
WantedBy=multi-user.target
