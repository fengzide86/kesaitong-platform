# 复制为 .env.marketing.local；仅是官网发布配置，不改变桌面/API配置。
# 授权使用 npm run marketing:publish -- --login，凭据不放此文件或 Git。
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_PAGES_PROJECT=kesaitong
# cloudflare（默认）或 github-pages；GitHub 使用已启用 Pages 的独立宣传站仓库。
KST_MARKETING_PROVIDER=cloudflare
# GITHUB_PAGES_REPOSITORY=your-account/your-account.github.io
KST_MARKETING_SITE_URL=https://kesaitong.pages.dev
# 留空时验证已发布清单及同源 /updates/latest.exe 跳转，使用稳定下载入口。
# 仅允许当前正式版本文件或此稳定入口；无效时失败，不回退旧包。
VITE_DESKTOP_DOWNLOAD_URL=
