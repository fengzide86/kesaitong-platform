# Copy this file to .env.docker before running Docker Compose.
# These values are for the isolated local stack only. Do not reuse production secrets.

COMPOSE_PROJECT_NAME=amazon-toolbox
TOOLBOX_API_PORT=8000

MARIADB_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_DATABASE=amazon_toolbox
MYSQL_USER=toolbox
MYSQL_PASSWORD=replace-with-local-db-password

JWT_SECRET_KEY=replace-with-a-random-local-key-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:4173,http://127.0.0.1:5173,null,app://toolbox
RATE_LIMIT_PER_MINUTE=60
# Redis is required for distributed limiting/revocation in internal/production.
# Optional degradation is opt-in, only for a deliberate single-process setup.
REDIS_REQUIRED=true
